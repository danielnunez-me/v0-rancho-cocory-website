# ===========================================
# Rancho Cocory Monorepo — Environment Variables
# ===========================================

# --- Database (Firebase Firestore + Storage) ---
# Create a Firebase project, enable Firestore and Storage, and generate a service account key.
# Map the JSON fields to these env vars (escape newlines in the private key as \n for Vercel).
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Storage bucket name from Firebase Console → Storage (e.g. project-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=""

# --- CMS Auth ---
EDIT_KEY="dev-edit-key"
ADMIN_PASSWORD="admin123"

# --- Backend (apps/api local dev only) ---
PORT=3001
FRONTEND_ORIGIN="http://localhost:3000"

# Instagram Graph API (optional — fallback posts used if empty)
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""

# Google Places API (optional — shows message if empty)
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID="ChIJ6eHmZkhIqowRNY9WuTsX2289"

# --- Legacy (optional) ---
# CMS_API_URL is no longer required when using Next.js /api/cms route handlers.
# Only set this if running the separate Hono API during local development:
# CMS_API_URL="http://localhost:3001"
