{
  "name": "rancho-cocory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter web build",
    "vercel-build": "pnpm db:generate && pnpm --filter web build",
    "db:migrate": "pnpm --filter @rancho-cocory/cms-server db:migrate",
    "db:seed": "pnpm --filter @rancho-cocory/cms-server db:seed",
    "db:generate": "pnpm --filter @rancho-cocory/cms-server db:generate",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
